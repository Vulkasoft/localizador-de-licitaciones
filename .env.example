# Copia este archivo a .env y rellena los valores:  cp .env.example .env
# NUNCA subas el .env al repositorio.

# ---------- Servidor ----------
# Dominio público de la app (lo usa Caddy para el certificado HTTPS)
DOMAIN=licitaciones.tudominio.com
# URL pública completa (debe coincidir con el dominio)
NEXTAUTH_URL=https://licitaciones.tudominio.com
# Genera uno con:  openssl rand -base64 32
# (Usa el mismo valor que en Abacus si quieres que las sesiones abiertas sigan valiendo)
NEXTAUTH_SECRET=

# Registro de usuarios: cerrado por defecto (solo el primer usuario, que queda como
# administrador, o un administrador con sesión iniciada pueden crear cuentas).
# Pon true para permitir que cualquiera se registre desde la pantalla de login.
ALLOW_SIGNUP=false

# ---------- Base de datos (PostgreSQL en Docker) ----------
POSTGRES_USER=licitaciones
POSTGRES_PASSWORD=
POSTGRES_DB=licitaciones
# DATABASE_URL la construye docker-compose a partir de los valores anteriores.

# ---------- Tareas programadas ----------
# Secreto que usa el contenedor "cron" para llamar a la app. Genera uno con:  openssl rand -hex 24
ALARM_CRON_SECRET=

# ---------- Correo (SMTP) — sustituye a las notificaciones de Abacus ----------
# Sirve cualquier proveedor SMTP: Gmail/Google Workspace (contraseña de aplicación),
# Microsoft 365, Brevo, Mailgun, Amazon SES, el correo de tu hosting...
SMTP_HOST=smtp.tuproveedor.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=avisos@tudominio.com
SMTP_FROM_NAME=Gestión DJI

# ---------- IA (análisis de pliegos) — sustituye a la IA de Abacus ----------
# Clave de la API de Anthropic (https://platform.claude.com). Sin ella, el botón de
# "Analizar con IA" mostrará "El servicio de IA no está configurado".
ANTHROPIC_API_KEY=
# Opcional: modelo a usar (por defecto claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# ---------- Archivos adjuntos (almacenamiento compatible con S3) ----------
# AWS S3, Cloudflare R2, Backblaze B2, Wasabi o MinIO.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
AWS_BUCKET_NAME=
AWS_FOLDER_PREFIX=
# Solo si NO es AWS (p. ej. Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com y AWS_REGION=auto)
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
# S3_PUBLIC_URL=
# IMPORTANTE: el bucket necesita una regla CORS que permita PUT/GET desde NEXTAUTH_URL,
# porque el navegador sube los archivos directamente al bucket.

# ---------- Agente externo (ChatGPT / MCP) ----------
AGENT_API_KEY=
# Identificador antiguo, aceptado por compatibilidad (opcional)
# CHATGPT_AGENT_CHANNEL_ID=

# ---------- Contasimple ----------
CONTASIMPLE_API_URL=
CONTASIMPLE_AUTH_KEY=
CONTASIMPLE_AUTH_KEY_PENINSULA=
CONTASIMPLE_AUTH_KEY_CANARIAS=
CONTASIMPLE_INVOICE_FORMAT_ID_PENINSULA=
CONTASIMPLE_INVOICE_FORMAT_ID_CANARIAS=
CONTASIMPLE_TRAINING_INVOICE_CLASS_PENINSULA=
CONTASIMPLE_TRAINING_INVOICE_CLASS_CANARIAS=

# ---------- Google Calendar ----------
# En Google Cloud Console añade como URI de redirección autorizada:
#   <NEXTAUTH_URL>/api/calendar/google/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# GOOGLE_CALENDAR_REDIRECT_URI=

# ---------- Integración BlueDrone Training (Google Drive + Contasimple) ----------
BLUEDRONE_TRAINING_WEBHOOK_SECRET=
BLUEDRONE_DRIVE_ROOT_FOLDER_ID=
# JSON completo de la cuenta de servicio de Google, en una sola línea
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
# GOOGLE_DRIVE_IMPERSONATE_USER=
BLUEDRONE_TRAINING_DRY_RUN=true
BLUEDRONE_TRAINING_DRIVE_WRITE_ENABLED=false
BLUEDRONE_TRAINING_CONTASIMPLE_WRITE_ENABLED=false
BLUEDRONE_TRAINING_CONTASIMPLE_ALLOWED_IDEMPOTENCY_KEY=
# BLUEDRONE_TRAINING_EXENCION_LEGEND_PENINSULA=
# BLUEDRONE_TRAINING_EXENCION_LEGEND_CANARIAS=

# ---------- Puerto local de la app (opcional) ----------
# APP_PORT=3000
